# ============================================================
# INTIWATANA - Variables de entorno
# ============================================================
# Copiar este archivo como `.env` en backend/bus-system/ y completar
# los valores reales. El archivo `.env` esta EXCLUIDO por .gitignore.
# NUNCA subir a git un archivo con secretos reales.
#
# En produccion los valores se inyectan como variables de entorno del
# sistema (systemd, Docker, Kubernetes, etc.); este archivo NO se usa
# en el servidor de produccion.
# ============================================================

# -- Entorno -------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -- Servidor ------------------------------------------------
SERVER_PORT=8080

# -- Base de datos PostgreSQL --------------------------------
# Produccion: usar un usuario EXCLUSIVO de la aplicacion (no `postgres`)
# con permisos minimos, y una base de datos separada.
DB_URL=jdbc:postgresql://localhost:5432/transporte_bd
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=3

# -- JWT ------------------------------------------------------
# Generar: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# En produccion DEBE ser distinto al secreto de desarrollo.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_MS=604800000

# -- CORS -----------------------------------------------------
# Produccion: SOLO dominios oficiales, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Logging / Actuator --------------------------------------
LOG_LEVEL_APP=INFO
LOG_FILE=logs/sistema-transporte.log
ACTUATOR_ENDPOINTS=health,info,metrics
ACTUATOR_HEALTH_DETAILS=when-authorized
