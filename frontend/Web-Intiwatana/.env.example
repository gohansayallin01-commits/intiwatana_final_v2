# ============================================================
# INTIWATANA - Frontend (Vite)
# ============================================================
# Copiar como `.env` / `.env.local` segun entorno. Excluido por .gitignore.
# ADVERTENCIA: las variables VITE_* se exponen en el bundle publico.
# NUNCA poner secretos aqui (contrasenas, JWT_SECRET, tokens, credenciales).
# ============================================================

# URL del backend SOLO para el proxy del servidor de desarrollo de Vite.
# No se incluye en el bundle de produccion (que usa rutas relativas /api).
VITE_PROXY_TARGET=http://localhost:8080

# Identificador visible del entorno (no sensible).
VITE_APP_ENV=development
